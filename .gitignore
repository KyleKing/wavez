# Built binary (from copier project_name)
/wavez

# Changelog scratch file written by the commitizen action; goreleaser's dirty
# check must not see it as untracked
body.md

# Go binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and coverage
*.test
*.out
coverage.out
coverage.html
*.cover
*.coverprofile

# Delve debugger
__debug_bin*

# Build artifacts
dist/
bin/
build/

# Go workspace files (local only)
go.work
go.work.sum

# Dependency directories
vendor/

# Air (live reload) temporary directory
tmp/

# Environment files
.env
.env.local
.env.*.local

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*.swn
*~

# OS-specific
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# wavez runtime state. Wavez.pkl is deliberately tracked: `.wavez.pkl` amends
# it, so anything that evaluates the config (pkl eval, hk, an editor) needs it
# on disk. Wavez rewrites it from the binary on every load, so it self-heals.
/.wavez/*
!/.wavez/Wavez.pkl

# goreleaser output
/dist/

# jj working state
/.jj/
