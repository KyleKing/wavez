; Wavez v0.1 sandbox profile (macOS Seatbelt / sandbox-exec).
; Params (pass with -D, must be canonical / symlink-resolved paths, no trailing slash):
;   PROJECT_ROOT  project directory, writable
;   SESSION_TMP   one session's scratch dir (e.g. redirected GOCACHE/GOMODCACHE/GOTMPDIR), writable
;   HOME          user home dir, used only to build the secret-path deny list
;
; Network mode: default is loopback restricted to a single port (Ollama, 11434).
; See wavez-loopback-open.sb for the "any loopback port" variant and README.md
; for why hostname allowlisting is not directly expressible here.

(version 1)
(allow default)

; --- writes: project root + session tmp only ---
(deny file-write*)
(allow file-write*
  (subpath (param "PROJECT_ROOT"))
  (subpath (param "SESSION_TMP"))
  (literal "/dev/null")
  (literal "/dev/tty"))

; --- reads: everything except secrets ---
(deny file-read*
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/.aws"))
  (subpath (string-append (param "HOME") "/.config/gh"))
  (subpath (string-append (param "HOME") "/Library/Keychains"))
  (subpath (string-append (param "HOME") "/.claude")))

; --- network: loopback:11434 (Ollama) only ---
(deny network*)
(allow network-outbound (remote ip "localhost:11434"))
(allow network-inbound (local ip "localhost:11434"))
