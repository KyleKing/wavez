amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"

import ".wavez.pkl" as wavez

min_hk_version = "1.54.0"

local fmtStep = wavez.routines["fmt"].steps[0]

hooks {
  ["pre-commit"] {
    fix = true
    steps {
      ["wavez-fmt"] {
        glob = List("*.go")
        fix = fmtStep.cmd.join(" ")
      }
    }
  }
}
