; Wavez v0.1 sandbox profile (macOS Seatbelt / sandbox-exec).
; Generated by internal/sandbox; paths below are realpath-resolved.

(version 1)
(allow default)

; --- writes: project root + session tmp only ---
(deny file-write*)
(allow file-write*
  (subpath "/PROJECT_ROOT")
  (subpath "/SESSION_TMP")
  (literal "/dev/null")
  (literal "/dev/tty"))

; --- reads: everything except secrets ---
(deny file-read*
  (subpath "/HOME/.ssh")
  (subpath "/HOME/.aws")
  (subpath "/HOME/.config/gh")
  (subpath "/HOME/Library/Keychains")
  (subpath "/HOME/.claude")
)

; --- network: loopback only ---
(deny network*)
(allow network-outbound (remote ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
