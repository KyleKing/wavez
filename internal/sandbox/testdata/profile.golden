; Wavez v0.2 sandbox profile (macOS Seatbelt / sandbox-exec).
; Generated by internal/sandbox; paths below are realpath-resolved.

(version 1)
(allow default)

; --- writes: project root + session tmp only ---
(deny file-write*)
(allow file-write*
  (subpath "/PROJECT_ROOT")
  (subpath "/SESSION_TMP")
  (literal "/dev/null")
  (literal "/dev/tty")
  (literal "/dev/ptmx")
  (regex #"^/dev/ttys[0-9]+$"))

; --- writes: not the files that decide what may run next ---
(deny file-write*
  (regex #"^/PROJECT_ROOT(/.*)?/\.git($|/)")
  (regex #"^/PROJECT_ROOT(/.*)?/\.jj($|/)")
  (subpath "/PROJECT_ROOT/.config/mise.toml")
  (subpath "/PROJECT_ROOT/.config/mise/conf.d")
  (subpath "/PROJECT_ROOT/.config/mise/config.toml")
  (subpath "/PROJECT_ROOT/.config/mise/tasks")
  (subpath "/PROJECT_ROOT/.github/workflows")
  (subpath "/PROJECT_ROOT/.mise-tasks")
  (subpath "/PROJECT_ROOT/.mise.local.toml")
  (subpath "/PROJECT_ROOT/.mise.toml")
  (subpath "/PROJECT_ROOT/.mise/config.toml")
  (subpath "/PROJECT_ROOT/.mise/tasks")
  (subpath "/PROJECT_ROOT/.wavez.pkl")
  (subpath "/PROJECT_ROOT/.wavez/approvals.jsonl")
  (subpath "/PROJECT_ROOT/hk.pkl")
  (subpath "/PROJECT_ROOT/mise-tasks")
  (subpath "/PROJECT_ROOT/mise.local.toml")
  (subpath "/PROJECT_ROOT/mise.toml")
  (subpath "/PROJECT_ROOT/mise/config.toml")
  (subpath "/PROJECT_ROOT/mise/tasks")
)
(allow file-write* (subpath "/SESSION_TMP"))

; --- reads: the project and the toolchain, nothing else under home ---
(deny file-read* (subpath "/HOME"))
(allow file-read*
  (subpath "/HOME/.bun")
  (subpath "/HOME/.cache")
  (subpath "/HOME/.cargo")
  (subpath "/HOME/.config/mise")
  (subpath "/HOME/.deno")
  (subpath "/HOME/.dotnet")
  (subpath "/HOME/.gradle")
  (subpath "/HOME/.local")
  (subpath "/HOME/.m2")
  (subpath "/HOME/.npm")
  (subpath "/HOME/.nvm")
  (subpath "/HOME/.pyenv")
  (subpath "/HOME/.rbenv")
  (subpath "/HOME/.rustup")
  (subpath "/HOME/.sdkman")
  (subpath "/HOME/Library/Caches")
  (subpath "/HOME/Library/pnpm")
  (subpath "/HOME/go")
  (subpath "/PROJECT_ROOT")
  (subpath "/SESSION_TMP")
  (literal "/HOME")
  (literal "/HOME/.config")
  (literal "/HOME/Library")
)

; --- network: loopback only ---
(deny network*)
(allow network-outbound (remote ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
