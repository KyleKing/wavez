; Wavez v0.2 sandbox profile (macOS Seatbelt / sandbox-exec).
; Generated by internal/sandbox; paths below are realpath-resolved.

(version 1)
(allow default)

; --- writes: project root + session tmp only ---
(deny file-write*)
(allow file-write*
  (subpath "/HOME/work/proj")
  (subpath "/SESSION_TMP")
  (literal "/dev/null")
  (literal "/dev/tty")
  (literal "/dev/ptmx")
  (regex #"^/dev/ttys[0-9]+$"))

; --- writes: not the files that decide what may run next ---
(deny file-write*
  (regex #"^/HOME/work/proj(/.*)?/\.git($|/)")
  (regex #"^/HOME/work/proj(/.*)?/\.jj($|/)")
  (subpath "/HOME/work/proj/.config/mise.toml")
  (subpath "/HOME/work/proj/.config/mise/conf.d")
  (subpath "/HOME/work/proj/.config/mise/config.toml")
  (subpath "/HOME/work/proj/.config/mise/tasks")
  (subpath "/HOME/work/proj/.github/workflows")
  (subpath "/HOME/work/proj/.mise-tasks")
  (subpath "/HOME/work/proj/.mise.local.toml")
  (subpath "/HOME/work/proj/.mise.toml")
  (subpath "/HOME/work/proj/.mise/config.toml")
  (subpath "/HOME/work/proj/.mise/tasks")
  (subpath "/HOME/work/proj/.wavez.pkl")
  (subpath "/HOME/work/proj/.wavez/approvals.jsonl")
  (subpath "/HOME/work/proj/hk.pkl")
  (subpath "/HOME/work/proj/mise-tasks")
  (subpath "/HOME/work/proj/mise.local.toml")
  (subpath "/HOME/work/proj/mise.toml")
  (subpath "/HOME/work/proj/mise/config.toml")
  (subpath "/HOME/work/proj/mise/tasks")
)
(allow file-write* (subpath "/SESSION_TMP"))

; --- reads: the project and the toolchain, nothing else under home ---
(deny file-read* (subpath "/HOME"))
(allow file-read*
  (subpath "/HOME/.bun")
  (subpath "/HOME/.cache")
  (subpath "/HOME/.cargo")
  (subpath "/HOME/.config/mise")
  (subpath "/HOME/.deno")
  (subpath "/HOME/.dotnet")
  (subpath "/HOME/.gradle")
  (subpath "/HOME/.local")
  (subpath "/HOME/.m2")
  (subpath "/HOME/.npm")
  (subpath "/HOME/.nvm")
  (subpath "/HOME/.pyenv")
  (subpath "/HOME/.rbenv")
  (subpath "/HOME/.rustup")
  (subpath "/HOME/.sdkman")
  (subpath "/HOME/Library/Caches")
  (subpath "/HOME/Library/pnpm")
  (subpath "/HOME/go")
  (subpath "/HOME/work/proj")
  (subpath "/HOME/work/sibling")
  (subpath "/SESSION_TMP")
  (literal "/HOME")
  (literal "/HOME/.config")
  (literal "/HOME/Library")
  (literal "/HOME/work")
)

; --- network: loopback only ---
(deny network*)
(allow network-outbound
  (remote ip "localhost:8080")
)
