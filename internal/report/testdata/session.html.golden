<script>
(function () {
  document.documentElement.classList.remove('nojs');
  function fallback(text) {
    var area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.opacity = '0';
    document.body.appendChild(area);
    area.select();
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    document.body.removeChild(area);
    return ok;
  }
  function say(button, ok) {
    var was = button.getAttribute('data-label') || button.textContent;
    button.setAttribute('data-label', was);
    button.textContent = ok ? 'Copied' : 'Select and copy';
    button.classList.toggle('done', ok);
    setTimeout(function () { button.textContent = was; button.classList.remove('done'); }, 1800);
  }
  document.querySelectorAll('.copy').forEach(function (button) {
    button.addEventListener('click', function () {
      var text = document.getElementById(button.getAttribute('data-copy')).textContent;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(
          function () { say(button, true); },
          function () { say(button, fallback(text)); });
      } else {
        say(button, fallback(text));
      }
    });
  });
  var pin = document.getElementById('pin');
  var detail = document.getElementById('pin-detail');
  var pinned = null;
  function show(cell) {
    pin.textContent = '';
    var b = document.createElement('b');
    b.textContent = cell.title;
    pin.appendChild(b);
    detail.textContent = cell.getAttribute('data-detail') || '';
  }
  document.querySelectorAll('#strip .c').forEach(function (cell) {
    cell.addEventListener('focus', function () { if (!pinned) { show(cell); } });
    cell.addEventListener('mouseenter', function () { if (!pinned) { show(cell); } });
    cell.addEventListener('click', function () {
      if (pinned) { pinned.classList.remove('on'); }
      pinned = pinned === cell ? null : cell;
      if (pinned) { cell.classList.add('on'); }
      show(cell);
    });
  });
}());
</script>
