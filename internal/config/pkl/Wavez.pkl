/// Wavez project config schema (DESIGN.md "Project instructions" and "Gates
/// (v0.1)"). A project's `.wavez.pkl` amends this module. Wavez writes this
/// file into the project's `.wavez/` directory on every load, so amend it as
/// `".wavez/Wavez.pkl"`, not a copy checked into the project.
module wavez.Wavez

/// Files or headed sections (e.g. "AGENTS.md#architecture") that enter the
/// agent's stable system prefix. Nothing outside this list is read
/// automatically: Wavez does not auto-load AGENTS.md, CLAUDE.md, .agents/,
/// or .claude/.
context: Listing<String> = new Listing {}

/// Local model name served by llama-server.
localModel: String = "qwen3:8b"

/// Hosted model name, escalated to per internal/router. The default is the
/// coder model DESIGN.md's risk list rules out locally at 19 GB, which running
/// it hosted resolves.
hostedModel: String = "openai/gpt-5-mini"

/// Command whose stdout is the hosted API key, after the shape of a git
/// credential helper, so the key never enters the environment or the repo.
/// Examples: "op read op://vault/item/credential" or
/// "security find-generic-password -w -s wavez-openrouter". When empty, Wavez
/// falls back to the OPENROUTER_API_KEY environment variable.
hostedKeyCommand: String = ""

/// Local model's served context window, in tokens. Wavez starts llama-server
/// with it, routes a turn hosted once the request plus reply room would not
/// fit it, and compacts against it. A per-model context size set on the
/// models screen overrides it for that model.
contextWindow: Int = 8192

/// Loopback port llama-server serves the local model on. Wavez reuses a
/// server already answering there instead of starting a second one, since
/// only one model fits in 16 GB.
localPort: Int = 8080

/// OpenAI-compatible endpoint root of a llama-server on another machine
/// (e.g. "https://m4.tailnet.ts.net/v1"). When set, the local tier dials it
/// and Wavez never starts, stops, or probes a llama-server of its own, so a
/// remote endpoint that is down fails the turn rather than loading a 6 GB
/// model here. Empty means the loopback server on localPort. The memory
/// headroom the daemon measures still describes this laptop, not the remote
/// one.
localBaseURL: String = ""

/// Command whose stdout is the bearer token for localBaseURL, in the same
/// shape as hostedKeyCommand. Empty means no Authorization header.
localKeyCommand: String = ""

/// Seconds to wait for a started llama-server to report ready.
localStartTimeoutSeconds: Int = 60

/// Free-memory fraction at or above which a turn on the local model and a
/// gate run may overlap. Below it the scheduler serializes the two, since only
/// one model fits in 16 GB. Measured on this laptop: qwen3:8b loaded leaves
/// ~31% free, which is enough for a Go suite, while gemma4:12b leaves 14-18%,
/// which is not.
admissionHeadroom: Float = 0.25

/// Minutes a write lease on a directory subtree survives without being
/// renewed. It is the backstop for a thread that died mid-write, which nothing
/// else cleans up.
leaseTtlMinutes: Int = 30

/// Extra directories, beyond the project root, the agent may read and write.
extraDirs: Listing<String> = new Listing {}

/// Gate debounce, in milliseconds, before a batch of changes runs.
debounceMs: Int = 500

/// Selective gate passes allowed before a full run is forced.
fullRunCadence: Int = 20

/// Glob patterns for ast-grep convention rule files.
astGrepRules: Listing<String> = new Listing {}

/// Functions `wavez -deadcode` should not report, as `package.Function`
/// globs. A function no main reaches is not always a mistake: functional
/// options and test seams are reachable only from tests by design, and the
/// analyzer ignores tests on purpose.
deadcodeAllow: Listing<String> = new Listing {
  "*.With*"
}

/// Command run before every tool call, as an argv with the program first. It
/// is executed directly, never through a shell. It reads a JSON payload on
/// stdin (event, tool, input, paths) and answers with its exit status: 0
/// allows, 2 refuses, and every other status refuses as a failed hook. A hook
/// that times out, cannot start, or is killed refuses too, so breaking the
/// hook is never a way to widen what the agent may do. Its stdout and stderr
/// go to the thread's event log and never to the model. Empty means no hook
/// and no hook process.
/// Example: new Listing { ".wavez/hooks/pre-tool-use.sh" }
preToolUseHook: Listing<String> = new Listing {}

/// Command run after every tool call, as an argv with the program first. The
/// payload adds the tool's result and whether it errored. The tool has already
/// run, so this hook reports and cannot refuse: a nonzero exit or a timeout is
/// logged and the run continues.
postToolUseHook: Listing<String> = new Listing {}

/// Milliseconds one hook process may run before it is killed.
hookTimeoutMs: Int = 5000

/// When a routine fires. "change" runs it on the same debounced batch the
/// gates run on, "manual" only when a client asks, "schedule" every
/// `intervalSeconds`, and the thread triggers on a thread's first turn
/// starting and its last one finishing.
typealias Trigger = "change"|"manual"|"schedule"|"thread-start"|"thread-finish"

/// What happens to a run that arrives while its concurrency key is busy.
/// "queue" waits its turn, "cancel-in-progress" stops the running instance
/// and takes its place, and "round-robin" admits waiting routines in
/// rotation so one firing repeatedly cannot starve another on the same key.
typealias Concurrency = "queue"|"cancel-in-progress"|"round-robin"

/// One node of a routine's DAG.
class Step {
  /// Unique within the routine, and the name other steps put in `parents`.
  name: String

  /// Registered action this step invokes. An unknown action, or one whose
  /// parameters do not validate, fails the config load rather than the run.
  action: String

  /// Parameters for `action`, checked by that action's validator at load.
  params: Mapping<String, Any> = new Mapping<String, Any> {}

  /// Steps that must finish before this one starts. Steps with no
  /// unfinished parent run concurrently.
  parents: Listing<String> = new Listing<String> {}
}

/// A named DAG of actions. No model is involved in a routine.
class Routine {
  triggers: Listing<Trigger> = new Listing<Trigger> {}

  /// Glob patterns, matched against a changed file's repo-relative path,
  /// that narrow a "change" trigger. Empty matches every change.
  paths: Listing<String> = new Listing<String> {}

  /// Seconds between runs under the "schedule" trigger. Ignored otherwise.
  intervalSeconds: Int = 0

  steps: Listing<Step> = new Listing<Step> {}

  /// Runs sharing a key never overlap. Empty means the routine's own name.
  concurrencyKey: String = ""

  concurrency: Concurrency = "queue"

  /// A disabled routine stays readable in the file and never runs.
  enabled: Boolean = true
}

/// Routines this project defines. Gates ship as built-in routines under
/// their gate names, and a routine named here replaces the built-in of that
/// name outright: to turn a gate off, declare it with `enabled = false` and
/// no steps.
///
/// The typed constructor in the default is load-bearing. A `Mapping` or
/// `Listing` default written as `new Mapping {}` loses its element type, and
/// every `["name"] { ... }` an amending file writes then fails to evaluate
/// as a `Dynamic`.
routines: Mapping<String, Routine> = new Mapping<String, Routine> {}

/// One phase of a Cycle: what the model is told to achieve, the tools it may
/// call, and the condition the harness evaluates before the cycle advances.
class Phase {
  /// Phase name, shown in the thread log.
  name: String

  /// The standing instruction for this phase. It is the whole prompt the
  /// phase starts from, beside the change set and the ledger.
  goal: String

  /// Exit condition, by name. Wavez ships "artifact-fails" (a test the change
  /// set declares fails on the current tree), "artifact-passes-gates-green"
  /// (they all pass and the phase's gates were green), and "sweep-accounted"
  /// (a recorded structural sweep has every hit fixed or dismissed with a
  /// reason, or names a durable artifact instead). A condition the harness
  /// cannot evaluate would be a claim, which is why this is a fixed list.
  exit: String(this == "artifact-fails" || this == "artifact-passes-gates-green" || this == "sweep-accounted")

  /// Tools this phase may call. Narrowing is a routing lever rather than a
  /// fence: a narrow phase is a job a small local model can drive, and the
  /// exit condition is what makes cheating harder than working.
  tools: Listing<String> = new Listing {}

  /// How many times this phase's loop may run before the cycle ends with the
  /// condition unmet.
  maxAttempts: Int = 2

  /// Whether this phase's loop verifies its change set against the gates
  /// before completing. A phase whose product is a failing test leaves it off.
  gated: Boolean = true
}

/// A named, reusable, phased way of working on a class of problem. A cycle
/// named here replaces a built-in of the same name outright.
class Cycle {
  name: String
  phases: Listing<Phase>
}

/// Cycles this project can run, beside the built-in fix cycle.
cycles: Listing<Cycle> = new Listing {}

/// One identifier-linking rule: text matching `pattern` renders as a
/// hyperlink to `url`, which may reference the pattern's capture groups with
/// Go `regexp.Expand` syntax (`$1`).
class LinkPattern {
  pattern: String
  url: String
}

/// PR numbers, issue keys, and ticket ids this project links in the
/// transcript and in `-p` output. Repo entries take precedence over the
/// per-laptop user config on a clash; a pattern that fails to compile as a
/// Go regexp fails the config load.
/// Example: new LinkPattern { pattern = "#(\\d+)"; url = "https://github.com/kyleking/wavez/pull/$1" }
links: Listing<LinkPattern> = new Listing {}
