amends ".wavez/Wavez.pkl"

// Only what the agent cannot get from a gate. The rest of AGENTS.md is either
// enforced deterministically or irrelevant to a model mid-edit.
context = new Listing {
  "AGENTS.local.md#Go conventions"
}

astGrepRules = new Listing {
  "rules/*.yml"
}

// Read from the login keychain, so no key reaches the environment or the repo:
//   security add-generic-password -s wavez-openrouter -a "$USER" -w '<key>' -U
hostedKeyCommand = "security find-generic-password -w -s wavez-openrouter"

// The fast tier runs on this laptop while the laptop can keep up and moves
// to OpenRouter while it cannot. Decode was the whole wall clock of a replay
// lane (2,384 output tokens at 25.4 tok/s over 94 seconds) and its rate moved
// 16x with what else the machine was doing, which made a lane measure the
// machine rather than the tree. Serving it hosted instead did not fix that:
// OpenRouter's shared pool answers this model with a 429 partway through a
// run, and only Alibaba serves it, so there is no provider to route to.
//
// What moving costs is the grammar: llama-server compiles one from each
// tool's JSON schema, and the `oneOf` fix was measured through it. A lane
// asking about a grammar-constrained small model runs with the machine idle,
// and a replay record's `served` names both endpoints because it cannot say
// which answered.
//
// Reasoning is off on both because the fast tier only calls tools. Four
// hosted lanes against four local ones measured 930 output tokens a turn with
// it against 190 without, and a probe puts the same reply at 11 completion
// tokens against 79.
fast = new {
  model = "qwen3:8b"
  thinking = false
  overflow = new {
    model = "qwen/qwen3-8b"
    baseURL = "https://openrouter.ai/api/v1"
    thinking = false
  }
}

// Served window for the fast tier, which is also what a turn is routed
// against. It has to be the smaller of the two endpoints: a turn sized for
// OpenRouter's 128k would not fit the llama-server this laptop starts, and
// the pick between them happens after the routing decision.
contextWindow = 8192

// Both network tiers run the coder-tuned Qwen, the same family the local
// fast tier serves. It renders about one call in eight as `<function=…>`
// prose once a system prompt is present, which parseToolCallText reads back.
// The plain instruct sibling never leaks and scores worse on the replay
// tasks, so the dialect is the cheaper problem.
balanced = new { model = "qwen/qwen3-coder-30b-a3b-instruct" }

// The deep tier has to be a different model from the one below it or an
// escalation re-runs the failure on the model that just produced it, which
// is what both network tiers naming the same model meant. Kimi reasons by
// default, which is the point of a tier reached only when the tier below
// could not finish, and 14 providers serve it, so there is no repeat of the
// single-provider rate limit the fast tier hit.
deep = new { model = "moonshotai/kimi-k2.7-code" }

// Functions no main reaches that are deliberate rather than orphaned. The
// wildcard covers the functional options; the rest are named one at a time,
// so this list is the inventory of what is built and not yet wired and
// `wavez -deadcode` fails on anything new.
deadcodeAllow = new Listing {
  "*.With*"
  // The counterpart of AllowAll. A permission default that exists only when
  // something happens to call it is the wrong shape for a safety gate.
  "permission.DenyAll"
  // Resources is the gate interface every gate implements; this one is
  // unreachable because MutationGate itself is behind a flag.
  "gate.MutationGate.Resources"
  // The import graph that scopes a full run, built and not yet wired.
  "gate.NewImportGraph"
  // Single-file editing, superseded by ApplyToFiles when str_replace learned
  // to span files. Kept until a lane proves the batch path covers every case
  // internal/edit's own tests still pin here.
  "edit.ApplyToFile"
  "edit.ApplyAllToFile"
  "edit.Replace"
  "edit.ReplaceAll"
  // Orphans with no caller and no roadmap home. Each is a deletion waiting
  // on someone to confirm nothing outside this module wants it.
  "daemon.manager.queued"
  "routine.Registry.Names"
}
