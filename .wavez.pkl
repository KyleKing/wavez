amends ".wavez/Wavez.pkl"

// Only what the agent cannot get from a gate. The rest of AGENTS.md is either
// enforced deterministically or irrelevant to a model mid-edit.
context = new Listing {
  "AGENTS.local.md#Go conventions"
}

astGrepRules = new Listing {
  "rules/*.yml"
}

// The z.ai coding plan serves every network tier, so a turn that leaves this
// laptop costs a subscription rather than a token. A coding-plan key opens
// only the coding endpoint: the general "/api/paas/v4" root refuses it.
local zaiBase = "https://api.z.ai/api/coding/paas/v4"

// Read from the login keychain, so no key reaches the environment or the repo:
//   security add-generic-password -s wavez-zai -a "$USER" -w '<key>' -U
// Each tier names it rather than falling back to hostedKeyCommand, so a tier
// moved to another provider fails to authenticate instead of handing that
// provider this key.
local zaiKey = "security find-generic-password -w -s wavez-zai"

// The fast tier runs on this laptop while the laptop can keep up and moves to
// z.ai while it cannot. Decode was the whole wall clock of a replay lane
// (2,384 output tokens at 25.4 tok/s over 94 seconds) and its rate moved 16x
// with what else the machine was doing, which made a lane measure the machine
// rather than the tree.
//
// What moving costs is the grammar: llama-server compiles one from each
// tool's JSON schema, and the `oneOf` fix was measured through it. A lane
// asking about a grammar-constrained small model runs with the machine idle,
// and a replay record's `served` names both endpoints because it cannot say
// which answered.
//
// The overflow is sized for what this tier does rather than for the plan's
// ceiling, since a tier reached because the machine is busy is the one place
// latency is already the problem.
//
// Reasoning is off on both because the fast tier only calls tools. Four
// hosted lanes against four local ones measured 930 output tokens a turn with
// it against 190 without, and a probe puts the same reply at 11 completion
// tokens against 79.
fast = new {
  model = "qwen3:8b"
  thinking = false
  overflow = new {
    model = "glm-4.7-flash"
    baseURL = zaiBase
    keyCommand = zaiKey
    thinking = false
  }
}

// The tier a turn carrying an image goes to. The coding plan serves it on the
// same endpoint and the same key as the text tiers: `glm-5.3` there refuses an
// image with "messages.content.type is invalid, allowed values: ['text']",
// and `glm-4.6v` answers one. It is not listed by that endpoint's /models,
// which reports only the text models, so the name is the thing that works
// rather than the thing advertised.
//
// Reasoning is off because it is on by default here and puts the answer in
// `reasoning_content` with `content` empty: the same question came back as
// four completion tokens with it disabled.
vision = new Tier {
  model = "glm-4.6v"
  baseURL = zaiBase
  keyCommand = zaiKey
  thinking = false
}

// Served window for the fast tier, which is also what a turn is routed
// against. It has to be the smaller of the two endpoints: a turn sized for
// z.ai's window would not fit the llama-server this laptop starts, and the
// pick between them happens after the routing decision.
contextWindow = 8192

// Both network tiers serve GLM-5.3 and the escalation between them is the
// reasoning pass. The deep tier has to differ from the one below it or an
// escalation re-runs the failure on the model that just produced it, which is
// what both network tiers naming the same model on the same settings meant.
// Reasoning is the lever this config has, and it is the one worth spending on
// a tier reached only when the tier below could not finish.
balanced = new {
  model = "glm-5.3"
  baseURL = zaiBase
  keyCommand = zaiKey
  thinking = false
}

deep = new {
  model = "glm-5.3"
  baseURL = zaiBase
  keyCommand = zaiKey
  thinking = true
}

// Functions no main reaches that are deliberate rather than orphaned. The
// wildcard covers the functional options; the rest are named one at a time,
// so this list is the inventory of what is built and not yet wired and
// `wavez -deadcode` fails on anything new.
deadcodeAllow = new Listing {
  "*.With*"
  // The counterpart of AllowAll. A permission default that exists only when
  // something happens to call it is the wrong shape for a safety gate.
  "permission.DenyAll"
  // Resources is the gate interface every gate implements; this one is
  // unreachable because MutationGate itself is behind a flag.
  "gate.MutationGate.Resources"
  // The import graph that scopes a full run, built and not yet wired.
  "gate.NewImportGraph"
  // Single-file editing, superseded by ApplyToFiles when str_replace learned
  // to span files. Kept until a lane proves the batch path covers every case
  // internal/edit's own tests still pin here.
  "edit.ApplyToFile"
  "edit.ApplyAllToFile"
  "edit.Replace"
  "edit.ReplaceAll"
  // Orphans with no caller and no roadmap home. Each is a deletion waiting
  // on someone to confirm nothing outside this module wants it.
  "daemon.manager.queued"
  "routine.Registry.Names"
}
