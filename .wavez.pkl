amends ".wavez/Wavez.pkl"

// Only what the agent cannot get from a gate. The rest of AGENTS.md is either
// enforced deterministically or irrelevant to a model mid-edit.
context = new Listing {
  "AGENTS.local.md#Go conventions"
}

astGrepRules = new Listing {
  "rules/*.yml"
}

// Read from the login keychain, so no key reaches the environment or the repo:
//   security add-generic-password -s wavez-openrouter -a "$USER" -w '<key>' -U
hostedKeyCommand = "security find-generic-password -w -s wavez-openrouter"

// Both network tiers run the coder-tuned Qwen, the same family the local
// fast tier serves. It renders about one call in eight as `<function=…>`
// prose once a system prompt is present, which parseToolCallText reads back.
// The plain instruct sibling never leaks and scores worse on the replay
// tasks, so the dialect is the cheaper problem.
balanced = new { model = "qwen/qwen3-coder-30b-a3b-instruct" }

deep = new { model = "qwen/qwen3-coder-30b-a3b-instruct" }
